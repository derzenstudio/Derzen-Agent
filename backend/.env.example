# DERZEN backend configuration.
# Copy this file to ".env" and fill in the values. Never commit your real .env.

# ── REQUIRED (no defaults, for security) ──────────────────────────────────────
# Only these contacts (emails / phone numbers) may trigger actions.
WHITELIST_CONTACTS=you@example.com
# Root directory for ALL file operations. Everything is sandboxed under here.
ALLOWED_BASE=C:/AI_Automation

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Origin of the frontend dev server. The Vite dev server runs on port 3000.
ALLOWED_ORIGIN=http://localhost:3000

# ── Subdirectories (relative to ALLOWED_BASE) ─────────────────────────────────
DOWNLOAD_SUBDIR=Downloads
REPORTS_SUBDIR=Reports
MODELS_SUBDIR=Models
ASSETS_SUBDIR=Assets
LOGS_SUBDIR=Logs
PIPELINES_SUBDIR=Pipelines
BROWSER_DATA_SUBDIR=BrowserData

# ── Email (optional; leave blank to disable) ──────────────────────────────────
EMAIL_SENDER=
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_ENABLED=false

# ── AI (local Ollama) ─────────────────────────────────────────────────────────
AI_BACKEND=ollama
DEFAULT_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=false

# ── Google Drive (optional) ───────────────────────────────────────────────────
# For the drive_upload node. Create an OAuth 2.0 *Desktop* client in Google
# Cloud Console, download the client-secrets JSON, and point these at it. The
# token file is created automatically after you approve access once.
GOOGLE_OAUTH_CLIENT=
GOOGLE_OAUTH_TOKEN=
# Optional: upload into a specific Drive folder (copy the id from its URL).
GOOGLE_DRIVE_FOLDER_ID=
