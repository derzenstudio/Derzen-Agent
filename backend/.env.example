# DERZEN backend configuration.
# Copy this file to ".env" and fill in the values. Never commit your real .env.

# ── REQUIRED (no defaults, for security) ──────────────────────────────────────
# Only these contacts (emails / phone numbers) may trigger actions.
WHITELIST_CONTACTS=you@example.com
# Root directory for ALL file operations. Everything is sandboxed under here.
ALLOWED_BASE=C:/AI_Automation

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Origin of the frontend dev server (Vite default is 5173).
ALLOWED_ORIGIN=http://localhost:5173

# ── Subdirectories (relative to ALLOWED_BASE) ─────────────────────────────────
DOWNLOAD_SUBDIR=Downloads
REPORTS_SUBDIR=Reports
MODELS_SUBDIR=Models
ASSETS_SUBDIR=Assets
LOGS_SUBDIR=Logs
PIPELINES_SUBDIR=Pipelines
BROWSER_DATA_SUBDIR=BrowserData

# ── Email (optional; leave blank to disable) ──────────────────────────────────
EMAIL_SENDER=
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── WhatsApp (optional) ───────────────────────────────────────────────────────
WHATSAPP_ENABLED=false

# ── AI (local Ollama) ─────────────────────────────────────────────────────────
AI_BACKEND=ollama
DEFAULT_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=false
